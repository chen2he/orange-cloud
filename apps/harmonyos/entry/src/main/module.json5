{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        // R2 上传/下载走连续后台任务（DATA_TRANSFER），切后台不中断传输
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      }
    ],
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // 连续后台任务类型：R2 大文件上传/下载期间的数据传输
        "backgroundModes": [
          "dataTransfer"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            // OAuth 回跳 Deep Link：orangecloud://oauth/callback
            "actions": [
              "ohos.want.action.viewData"
            ],
            "entities": [
              "entity.system.browsable"
            ],
            "uris": [
              {
                "scheme": "orangecloud",
                "host": "oauth",
                "path": "callback"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      },
      {
        // 晨昏「天窗」服务卡片
        "name": "OrangeCloudFormAbility",
        "srcEntry": "./ets/widget/OrangeCloudFormAbility.ets",
        "description": "$string:FormAbility_desc",
        "type": "form",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      },
      {
        // 后台延迟任务：token 保活 + 卡片刷新（WorkScheduler，等价 iOS BGAppRefreshTask）
        "name": "RefreshWorker",
        "srcEntry": "./ets/workscheduler/RefreshWorker.ets",
        "type": "workScheduler",
        "exported": false
      }
    ]
  }
}