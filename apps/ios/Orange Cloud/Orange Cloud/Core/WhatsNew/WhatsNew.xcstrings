            "value": "D1 Database Management"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "D1 資料庫管理"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "D1 資料庫管理"
          }
        },
        "ja": {
